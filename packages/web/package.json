{
  "name": "@calc/web",
  "version": "0.0.0",
  "private": true,
  "description": "Web consumer package for the scientific calculator. May depend on @calc/core; core never depends on web.",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@calc/core": "workspace:*"
  }
}
