{
  "name": "scientific-calculator",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for the scientific calculator monorepo (UI-agnostic core + web consumer).",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "build:core": "pnpm --filter @calc/core build",
    "build:web": "pnpm --filter @calc/web... build",
    "test": "pnpm -r test",
    "test:traceability": "node --test 'scripts/*.test.mjs'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
